<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used only to check for and download app updates from GitHub -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the app update itself without Android's extra confirm screen (Android 12+),
         once it installed the previous version itself -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Reminder notifications, checked once a day and after the phone restarts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only used if you choose to show reminders in a phone calendar -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Rough location, only for the compass (sun, TV mast and satellite directions) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Precise location, only if you allow it, to pin a trip's site on the map -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Caravan Leveller"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <!-- App icon choices (Settings > App icon): only one is switched on at a time.
             ".MainActivity" keeps its old name so home screen icons survive updates. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMotorhome"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_motorhome"
            android:roundIcon="@mipmap/ic_launcher_motorhome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCampervan"
            android:targetActivity=".HomeActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_campervan"
            android:roundIcon="@mipmap/ic_launcher_campervan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LevelActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ChecklistActivity"
            android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".VehicleActivity"
            android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ServiceActivity"
            android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ServiceEditActivity"
            android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RemindersActivity"
            android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DiaryActivity"
            android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DiaryEditActivity"
            android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SitesMapActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".TroubleshootActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CompassActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".AttachmentProvider"
            android:authorities="com.caravanlevel.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
